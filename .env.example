# ---------- Retrieval ----------
# Offline demo: hashing. Interview semantic mode: sentence_transformers.
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_BACKEND=faiss

# lightweight runs offline; cross_encoder uses BAAI/bge-reranker-base.
RERANKER_BACKEND=lightweight
RERANKER_MODEL=BAAI/bge-reranker-base
INITIAL_RECALL_K=24
RRF_K=60
MIN_RETRIEVAL_SCORE=0.40
MIN_EVIDENCE_SOURCES=1
CHUNK_SIZE=420
CHUNK_OVERLAP=80

# ---------- LLM ----------
# Compatible with OpenAI Chat Completions. Leave blank for safe offline fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=900
LLM_MAX_RETRIES=2

# ---------- API security ----------
API_AUTH_ENABLED=false
APP_API_KEY=replace-with-at-least-12-characters
CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=15
MAX_AGENT_STEPS=16
MAX_HISTORY_MESSAGES=10

# ---------- Persistence and logs ----------
# Empty DATABASE_URL uses local SQLite. Docker Compose configures PostgreSQL.
DATABASE_URL=
RAG_STORAGE_DIR=
LOG_LEVEL=INFO
JSON_LOGS=true
