# 默认混合检索不下载模型，也不需要API Key。
EMBEDDING_BACKEND=hybrid_tfidf
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

CHUNK_SIZE=420
CHUNK_OVERLAP=80
MIN_RETRIEVAL_SCORE=0.08
MAX_AGENT_STEPS=10
MAX_UPLOAD_MB=15

# 可选：配置兼容Chat Completions接口的大模型。
# 不配置时使用结构化降级回答，检索、工具和工单仍可正常运行。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=900

